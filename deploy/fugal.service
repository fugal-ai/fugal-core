# systemd unit for the Fugal router (install: deploy/README.md §3)
#
# Secrets live in /etc/fugal.env (mode 600), never in this file and never in the repo:
#   FUGAL_API_KEY      your OpenRouter key — the thing that spends money
#   FUGAL_SERVE_TOKEN  bearer token callers must present for answers (openssl rand -hex 24)
#
# ⚠️ THE OUTERMOST BRAKE IS NOT IN THIS FILE. The OpenRouter key carries its own hard
# spend limit, set in the OpenRouter dashboard. Whatever --spend-cap says, spend stops at
# the OpenRouter ceiling and every answer fails until it is raised. Set both.
[Unit]
Description=Fugal router endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fugal
WorkingDirectory=/opt/fugal-core
EnvironmentFile=/etc/fugal.env
Environment=FUGAL_MODEL=/opt/fugal-core/artifacts/Qwen3-0.6B
# --daily-cap enables the tokenless public tier under a shared per-UTC-day budget; drop it
# and answers require the bearer token. --spend-cap is the cumulative runaway brake (it
# resets on restart — it is a brake, not an accounting record). --host 0.0.0.0 so a
# containerised reverse proxy can reach the port over the bridge; keep :8090 closed to the
# internet with the host firewall and verify from off-box (deploy/README.md §5).
ExecStart=/opt/fugal-core/.venv/bin/python -m fugal --serve \
    --host 0.0.0.0 --port 8090 \
    --daily-cap 1.00 --rate-limit 6 --spend-cap 25.00
Restart=on-failure
RestartSec=5
# fp32 Qwen3-0.6B is ~2.4 GB steady-state; loading it peaks above that. 6G is headroom,
# not a measurement — check `systemctl status fugal` on your box and tighten it.
MemoryMax=6G
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/fugal-core
PrivateTmp=true

[Install]
WantedBy=multi-user.target
